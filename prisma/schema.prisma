generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  password      String
  role          Role           @default(USER)
  trialEndsAt   DateTime
  createdAt     DateTime       @default(now())
  photos        Photo[]
  subscriptions Subscription[]
  customTemplates CustomTemplate[]
}

enum Role {
  USER
  ADMIN
}

model Photo {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageData String   @db.Text
  layout    String   @default("strip")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String             @unique
  plan      String
  method    PaymentMethod
  amount    Int
  status    SubscriptionStatus @default(PENDING)
  proofData String?            @db.Text
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime           @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // 'proof_submitted' | 'payment_approved' | 'payment_rejected'
  title     String
  body      String
  read      Boolean  @default(false)
  userId    String   // siapa yang memicu notif ini
  orderId   String?  // referensi order
  createdAt DateTime @default(now())

  @@index([read])
  @@index([createdAt])
}

model CustomTemplate {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  category          String   @default("Kustom")
  tag               String   @default("Custom")
  tagColor          String   @default("bg-orange-600 text-white")
  usesCount         String   @default("0 uses")
  photosCount       Int      @default(4)
  recommendedLayout String   @default("strip4")
  bg                String   @default("#ffffff")
  frame             String   @default("#e85200")
  frameWidth        Int      @default(4)
  rounded           Int      @default(12)
  gap               Int      @default(12)
  pad               Int      @default(16)
  textColor         String   @default("#1c1c1c")
  labelText         String   @default("My Memories")
  subText           String   @default("FRAMERIO PHOTOBOOTH")
  filter            String   @default("none")
  styleType         String   @default("custom")
  bgImage           String?  @db.Text
  isPublic          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([isPublic])
}

enum PaymentMethod {
  DANA
  GOPAY
}

enum SubscriptionStatus {
  PENDING
  PAID
  REJECTED
  EXPIRED
}